# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables

# Google Maps / Places key for the candidate search autocomplete widget.
# Browser-side by nature — restrict it by HTTP referrer in the Google console.
NEXT_PUBLIC_GOOGLE_API_KEY_1=

# NEXT_PUBLIC_GOOGLE_API_KEY_2 was the Gemini key for app/api/demo/*. Those routes
# are deleted (see CLAUDE.md → "AI endpoints"). Do not re-add it: this repo holds no
# model credentials, because a public unmetered model endpoint is a bill anyone can
# run up. AI is served by the Moil backend, which owns the rate limits and ledgers.

# Analytics — each is optional. If unset, that tracker is not loaded at all
# (prevents firing scripts with placeholder IDs). See src/common/components/analytics.tsx
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
